{
  "name": "isc-auth",
  "version": "1.0.1",
  "description": "Authentication for Next.js",
  "keywords": [
    "react",
    "nextjs",
    "authentication",
    "auth",
    "oauth",
    "oauth2",
    "jwt",
    "session",
    "signin",
    "email",
    "passwordless"
  ],
  "homepage": "http://localhost",
  "repository": "https://github.com/iscexpo/isc-auth.git",
  "author": "ISC Expo <admin@iscexpo.edu.bd>",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "babel --config-file ./config/babel.config.json src --out-dir dist",
    "build:css": "postcss --config config/postcss.config.js src/**/*.css --base src --dir dist && node config/wrap-css.js",
    "dev": "next example | npm run watch:css",
    "watch": "npm run watch:js | npm run watch:css",
    "watch:js": "babel --config-file ./config/babel.config.json --watch src --out-dir dist",
    "watch:css": "postcss --config config/postcss.config.js --watch src/**/*.css --base src --dir dist",
    "test:app:start": "docker-compose -f tests/docker/app.yml up -d",
    "test:app:rebuild": "npm run build && docker-compose -f tests/docker/app.yml up -d --build",
    "test:app:stop": "docker-compose -f tests/docker/app.yml down",
    "test": "npm run test:app:rebuild && npm run test:unit && npm run test:integration && npm run test:app:stop",
    "test:db": "npm run test:db:mysql && npm run test:db:postgres && npm run test:db:mongodb && npm run test:db:mssql && npm run test:db:fauna",
    "test:db:mysql": "node tests/mysql.js",
    "test:db:postgres": "node tests/postgres.js",
    "test:db:mongodb": "node tests/mongodb.js",
    "test:db:mssql": "node tests/mssql.js",
    "test:db:fauna": "node tests/fauna.js",
    "test:unit": "mocha 'tests/unit/**/*.test.js'",
    "test:integration": "mocha tests/integration",
    "db:start": "docker-compose -f tests/docker/databases.yml up -d",
    "db:stop": "docker-compose -f tests/docker/databases.yml down",
    "prepublishOnly": "npm run build",
    "publish:beta": "npm publish --tag beta",
    "publish:canary": "npm publish --tag canary",
    "lint": "standard",
    "lint:fix": "standard --fix"
  },
  "files": [
    "dist",
    "index.js",
    "app.js",
    "providers.js",
    "adapters.js",
    "client.js",
    "jwt.js"
  ],
  "license": "ISC",
  "dependencies": {
    "crypto-js": "^4.0.0",
    "faunadb": "^3.0.1",
    "futoin-hkdf": "^1.3.2",
    "jose": "^3.20.4",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "oauth": "^0.9.15",
    "preact": "^10.4.1",
    "preact-render-to-string": "^5.1.7",
    "querystring": "^0.2.0",
    "require_optional": "^1.0.1",
    "typeorm": "^1.1.0"
  },
  "peerDependencies": {
    "react": "^17.0.1 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.1 || ^18.0.0 || ^19.0.0"
  },
  "peerOptionalDependencies": {
    "mongodb": "^3.5.9",
    "mysql": "^2.18.1",
    "mssql": "^6.2.1",
    "pg": "^8.2.1",
    "@prisma/client": "^2.12.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.9.6",
    "@babel/preset-env": "^7.9.6",
    "@semantic-release/commit-analyzer": "^8.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^7.1.3",
    "@semantic-release/release-notes-generator": "^9.0.1",
    "autoprefixer": "^10.5.4",
    "babel-preset-preact": "^2.0.0",
    "conventional-changelog-conventionalcommits": "4.4.0",
    "cssnano": "^5.1.15",
    "dotenv": "^8.2.0",
    "mocha": "^8.1.3",
    "mongodb": "^3.5.9",
    "mssql": "^12.7.0",
    "mysql": "^2.18.1",
    "next": "^16.3.2",
    "pg": "^8.2.1",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.1",
    "postcss-nested": "^7.0.1",
    "puppeteer": "^25.8.0",
    "puppeteer-extra": "^3.1.15",
    "puppeteer-extra-plugin-stealth": "^2.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "standard": "^16.0.3"
  },
  "standard": {
    "ignore": [
      "tests/",
      "example/"
    ],
    "globals": [
      "Headers",
      "Request",
      "Response",
      "FormData",
      "URLSearchParams",
      "URL"
    ]
  }
}
